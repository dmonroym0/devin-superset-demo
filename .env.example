# DEMO mode runs without real credentials.
APP_MODE=demo
GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=replace-me
DEVIN_API_BASE=https://api.devin.ai
DEVIN_API_KEY=
DEVIN_ORG_ID=org-xxxxxxxx
PLAYBOOK_TRIAGE_ID=
PLAYBOOK_FIX_ID=
PLAYBOOK_TRIAGE_TITLE=CVE Reachability Triage (Read-Only)
PLAYBOOK_FIX_TITLE=Dependency Security Fix (superset)
TRIAGE_ACU_CAP=5
FIX_ACU_CAP=15
ACU_CEILING=120
SWEEP_INTERVAL_S=300
SWEEP_ALLOWED_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
# DEMO defaults to 1 second; LIVE defaults to 15 seconds.
POLL_INTERVAL_S=1
SOFT_TIMEOUT_S=1800
HARD_TIMEOUT_S=5400
DEVIN_MODE_TRIAGE=
DEVIN_MODE_FIX=
# Persistent database directory (mounted at /data by Compose).
DATA_DIR=/data
# Optional exact path override; the mode guard rejects sharing it between DEMO and LIVE.
DB_PATH=
HOST=0.0.0.0
PORT=8000
